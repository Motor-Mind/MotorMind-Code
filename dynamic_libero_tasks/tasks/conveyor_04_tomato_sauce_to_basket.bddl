(define (problem LIBERO_Dynamic_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the tomato sauce from the conveyor belt and place it in the basket)
    (:regions
      (tomato_sauce_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 -0.3600 -0.0900 -0.3400)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 -0.2100 -0.0900 -0.1900)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (macaroni_and_cheese_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 -0.0600 -0.0900 -0.0400)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (popcorn_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 0.0900 -0.0900 0.1100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target main_table)
          (:ranges (
              (-0.3100 -0.3300 -0.2900 -0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    tomato_sauce_1 - tomato_sauce
    alphabet_soup_1 - alphabet_soup
    macaroni_and_cheese_1 - macaroni_and_cheese
    popcorn_1 - popcorn
    basket_1 - basket
  )

  (:obj_of_interest
    tomato_sauce_1
    basket_1
  )

  (:init
    (On tomato_sauce_1 main_table_tomato_sauce_1_region)
    (On alphabet_soup_1 main_table_alphabet_soup_1_region)
    (On macaroni_and_cheese_1 main_table_macaroni_and_cheese_1_region)
    (On popcorn_1 main_table_popcorn_1_region)
    (On basket_1 main_table_basket_1_region)
  )

  (:goal
    (And (On tomato_sauce_1 basket_1))
  )

)
