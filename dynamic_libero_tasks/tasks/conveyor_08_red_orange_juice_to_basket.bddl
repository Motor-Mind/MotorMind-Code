(define (problem LIBERO_Dynamic_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the red orange juice from the conveyor belt and place it in the basket)
    (:regions
      (milk_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 0.3400 -0.0900 0.3600)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_orange_juice_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 0.1900 -0.0900 0.2100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (orange_juice_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 0.0400 -0.0900 0.0600)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (yellow_milk_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 -0.1100 -0.0900 -0.0900)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target main_table)
          (:ranges (
              (-0.3100 0.3100 -0.2900 0.3300)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    milk_1 - milk
    red_orange_juice_1 - red_orange_juice
    orange_juice_1 - orange_juice
    yellow_milk_1 - yellow_milk
    basket_1 - basket
  )

  (:obj_of_interest
    red_orange_juice_1
    basket_1
  )

  (:init
    (On milk_1 main_table_milk_1_region)
    (On red_orange_juice_1 main_table_red_orange_juice_1_region)
    (On orange_juice_1 main_table_orange_juice_1_region)
    (On yellow_milk_1 main_table_yellow_milk_1_region)
    (On basket_1 main_table_basket_1_region)
  )

  (:goal
    (And (On red_orange_juice_1 basket_1))
  )

)
