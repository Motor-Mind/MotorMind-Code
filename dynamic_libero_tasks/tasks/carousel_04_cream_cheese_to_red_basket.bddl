(define (problem LIBERO_Dynamic_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the cream cheese from the rotating platform and place it in the red basket)
    (:regions
      (cream_cheese_1_region
          (:target main_table)
          (:ranges (
              (-0.1972 0.0895 -0.1772 0.1095)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_1_region
          (:target main_table)
          (:ranges (
              (-0.1495 -0.1172 -0.1295 -0.0972)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (0.0572 -0.0695 0.0772 -0.0495)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target main_table)
          (:ranges (
              (0.0095 0.1372 0.0295 0.1572)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_basket_1_region
          (:target main_table)
          (:ranges (
              (-0.3100 0.3100 -0.2900 0.3300)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    butter_1 - butter
    cookies_1 - cookies
    chocolate_pudding_1 - chocolate_pudding
    red_basket_1 - red_basket
  )

  (:obj_of_interest
    cream_cheese_1
    red_basket_1
  )

  (:init
    (On cream_cheese_1 main_table_cream_cheese_1_region)
    (On butter_1 main_table_butter_1_region)
    (On cookies_1 main_table_cookies_1_region)
    (On chocolate_pudding_1 main_table_chocolate_pudding_1_region)
    (On red_basket_1 main_table_red_basket_1_region)
  )

  (:goal
    (And (On cream_cheese_1 red_basket_1))
  )

)
