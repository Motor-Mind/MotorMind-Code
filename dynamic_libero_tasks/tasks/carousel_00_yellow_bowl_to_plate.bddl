(define (problem LIBERO_Dynamic_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the yellow bowl from the rotating platform and place it on the plate)
    (:regions
      (yellow_bowl_1_region
          (:target main_table)
          (:ranges (
              (0.0800 0.0100 0.1000 0.0300)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0700 0.1600 -0.0500 0.1800)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.2200 0.0100 -0.2000 0.0300)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_akita_black_bowl_1_region
          (:target main_table)
          (:ranges (
              (-0.0700 -0.1400 -0.0500 -0.1200)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.3100 0.3100 -0.2900 0.3300)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    yellow_bowl_1 - yellow_bowl
    akita_black_bowl_1 - akita_black_bowl
    white_bowl_1 - white_bowl
    red_akita_black_bowl_1 - red_akita_black_bowl
    plate_1 - plate
  )

  (:obj_of_interest
    yellow_bowl_1
    plate_1
  )

  (:init
    (On yellow_bowl_1 main_table_yellow_bowl_1_region)
    (On akita_black_bowl_1 main_table_akita_black_bowl_1_region)
    (On white_bowl_1 main_table_white_bowl_1_region)
    (On red_akita_black_bowl_1 main_table_red_akita_black_bowl_1_region)
    (On plate_1 main_table_plate_1_region)
  )

  (:goal
    (And (On yellow_bowl_1 plate_1))
  )

)
