(define (problem LIBERO_Dynamic_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the green chocolate pudding from the conveyor belt and place it in the wooden tray)
    (:regions
      (green_chocolate_pudding_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 -0.3600 -0.0900 -0.3400)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chocolate_pudding_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 -0.2100 -0.0900 -0.1900)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 -0.0600 -0.0900 -0.0400)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (yellow_cookies_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 0.0900 -0.0900 0.1100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_1_region
          (:target main_table)
          (:ranges (
              (-0.1100 0.2400 -0.0900 0.2600)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_tray_1_region
          (:target main_table)
          (:ranges (
              (-0.3400 -0.3700 -0.3200 -0.3500)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    green_chocolate_pudding_1 - green_chocolate_pudding
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    yellow_cookies_1 - yellow_cookies
    butter_1 - butter
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    green_chocolate_pudding_1
    wooden_tray_1
  )

  (:init
    (On green_chocolate_pudding_1 main_table_green_chocolate_pudding_1_region)
    (On chocolate_pudding_1 main_table_chocolate_pudding_1_region)
    (On cookies_1 main_table_cookies_1_region)
    (On yellow_cookies_1 main_table_yellow_cookies_1_region)
    (On butter_1 main_table_butter_1_region)
    (On wooden_tray_1 main_table_wooden_tray_1_region)
  )

  (:goal
    (And (On green_chocolate_pudding_1 wooden_tray_1))
  )

)
