(define (problem LIBERO_Dynamic_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the red salad dressing from the rotating platform and place it in the red basket)
    (:regions
      (red_salad_dressing_1_region
          (:target main_table)
          (:ranges (
              (0.0637 -0.0581 0.0837 -0.0381)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (salad_dressing_1_region
          (:target main_table)
          (:ranges (
              (-0.0019 0.1437 0.0181 0.1637)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target main_table)
          (:ranges (
              (-0.2037 0.0781 -0.1837 0.0981)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bbq_sauce_1_region
          (:target main_table)
          (:ranges (
              (-0.1381 -0.1237 -0.1181 -0.1037)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_basket_1_region
          (:target main_table)
          (:ranges (
              (-0.3100 -0.3300 -0.2900 -0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    red_salad_dressing_1 - red_salad_dressing
    salad_dressing_1 - salad_dressing
    ketchup_1 - ketchup
    bbq_sauce_1 - bbq_sauce
    red_basket_1 - red_basket
  )

  (:obj_of_interest
    red_salad_dressing_1
    red_basket_1
  )

  (:init
    (On red_salad_dressing_1 main_table_red_salad_dressing_1_region)
    (On salad_dressing_1 main_table_salad_dressing_1_region)
    (On ketchup_1 main_table_ketchup_1_region)
    (On bbq_sauce_1 main_table_bbq_sauce_1_region)
    (On red_basket_1 main_table_red_basket_1_region)
  )

  (:goal
    (And (On red_salad_dressing_1 red_basket_1))
  )

)
