(define (problem LIBERO_Dynamic_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the red mug from the rotating platform and place it on the plate)
    (:regions
      (red_coffee_mug_1_region
          (:target main_table)
          (:ranges (
              (-0.0287 0.1542 -0.0087 0.1742)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target main_table)
          (:ranges (
              (-0.2155 -0.0263 -0.1955 -0.0063)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_1_region
          (:target main_table)
          (:ranges (
              (0.0342 -0.0979 0.0542 -0.0779)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target main_table)
          (:ranges (
              (-0.3100 0.3100 -0.2900 0.3300)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    porcelain_mug_1 - porcelain_mug
    white_yellow_mug_1 - white_yellow_mug
    plate_1 - plate
  )

  (:obj_of_interest
    red_coffee_mug_1
    plate_1
  )

  (:init
    (On red_coffee_mug_1 main_table_red_coffee_mug_1_region)
    (On porcelain_mug_1 main_table_porcelain_mug_1_region)
    (On white_yellow_mug_1 main_table_white_yellow_mug_1_region)
    (On plate_1 main_table_plate_1_region)
  )

  (:goal
    (And (On red_coffee_mug_1 plate_1))
  )

)
